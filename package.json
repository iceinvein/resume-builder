{
  "name": "resume-builder",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build:worker": "bun build src/typst/worker.ts --target=browser --outdir public --entry-naming typst-worker.js && cp node_modules/@myriaddreamin/typst-ts-web-compiler/pkg/typst_ts_web_compiler_bg.wasm public/ && cp node_modules/@myriaddreamin/typst-ts-renderer/pkg/typst_ts_renderer_bg.wasm public/",
    "dev": "bun run build:worker && bun --hot server.ts",
    "build": "bun run build:worker && bun build src/index.html --outdir dist --splitting",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "e2e:serve": "bun run scripts/e2e.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@mdx-js/mdx": "^3.1.1",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0-rc2",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0-rc2",
    "@myriaddreamin/typst.ts": "^0.7.0-rc2",
    "codemirror": "^6.0.2",
    "idb-keyval": "^6.2.2",
    "json5": "^2.2.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.0.0",
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0"
  }
}
